# Public address of Baton (Caddy issues an internal certificate for *.local / *.internal names)
SITE_ADDRESS=baton.local
APP_URL=https://baton.local

# First administrator (used once by scripts/init.sh)
ADMIN_EMAIL=admin@baton.local
ADMIN_PASSWORD=

# E-mail relay (on-prem Exchange / Postfix). Leave SMTP_HOST empty to log mail instead.
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Baton <baton@jdj.local>

# Active Directory sign-in (optional). Map AD groups to roles under Administration → AD group mapping.
LDAP_URL=ldaps://dc01.jdj.local
LDAP_BASE_DN=DC=jdj,DC=local
LDAP_UPN_SUFFIX=jdj.local

# LIS integration (optional). Inbound events are HMAC-signed with this secret (see docs/LIS.md).
LIS_WEBHOOK_SECRET=
# Requisition check: {requisition} is replaced; 200 = exists (optional JSON patient_name), 404 = unknown.
LIS_VALIDATE_URL=
LIS_TOKEN=

# SkyLIMS (Mukon) HL7 v2 feed over MLLP on port 2575. Enable with COMPOSE_PROFILES=skylims.
# SKYLIMS_ALLOW: the SkyLIMS interface server's IP address(es), comma-separated. Leave empty only on an isolated lab network.
COMPOSE_PROFILES=
SKYLIMS_ALLOW=
